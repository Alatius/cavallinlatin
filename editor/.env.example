CAVALLIN_DB_PATH=data/cavallin.db
CAVALLIN_COLUMNS_DIR=data/columns
CAVALLIN_XML_PATH=data/cavallinlatin.xml
CAVALLIN_BASE_PATH=/cavallinlatin
# The session cookie is Secure by default; leave it that way in production.
# Only local dev over plain http may need the opt-out below (Chrome and
# Firefox accept Secure cookies on localhost, Safari does not):
#CAVALLIN_COOKIE_SECURE=false
CAVALLIN_COOKIE_NAME=cavallin_session
