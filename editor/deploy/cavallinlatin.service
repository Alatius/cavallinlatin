[Unit]
Description=Cavallin Lexicon backend (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cavallinlatin/editor/backend
EnvironmentFile=/var/www/cavallinlatin/editor/.env
ExecStart=/var/www/cavallinlatin/editor/backend/.venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=2s

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/www/cavallinlatin/editor/data
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
